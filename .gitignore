# ML training cache (models.json and context-cache.json are committed —
# ML inference silently degrades without the context cache)
src/data/ml/dataset.json
# Raw per-season game logs (large; durability.json derived from them is committed)
src/data/ml/gamelog-cache/

# Local GH Pages static-serve mirror
.serve-gh/


# Snake source DB (local only): it still holds opinions whose attribution is
# uncertain, caption spelling variants and extraction notes, none of which
# may be published. `npm run snake:build` bakes the public files from it.
/src/data/scouting/snake-boisvert.json

# The browser's copy of public/fantrax/dynasty.json (scripts/dynasty-client.ts:
# written by every dynasty build and before every site build)
/public/fantrax/dynasty-table.json
